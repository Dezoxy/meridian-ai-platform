"""The $name workload's graph.

Generated by `meridian workload new`: one node that calls no model and no tool.
Replace it with the workload's own, and list the tools it needs in the registry
first: an agent calls only the tools the registry lists for it. The state holds
plain data only, because the runtime runs LangGraph in strict msgpack mode.

Published in the entry-point group ``meridian.graphs`` (pyproject.toml).
"""

from typing import Any, TypedDict

from langgraph.graph import END, START, StateGraph

from meridian.runtime.model_client import ModelClient
from meridian.runtime.tool_client import ToolClient

AGENT = "$name"


class State(TypedDict):
    request: dict[str, Any]
    output: dict[str, Any]


def start(state: State) -> dict[str, Any]:
    return {"output": {"agent": AGENT}}


def build(model: ModelClient, tools: ToolClient) -> StateGraph:
    """The workload's graph factory. Returned uncompiled: the runtime compiles
    it with its checkpointer."""
    graph = StateGraph(State)
    graph.add_node("start", start)
    graph.add_edge(START, "start")
    graph.add_edge("start", END)
    return graph
