"""Checks of the generated $name workload.

Written by `meridian workload new`. Keep them while the workload is empty, and
replace them with the workload's own.
"""

from pathlib import Path

import pytest

from meridian.platform.evaluation.fingerprints import golden_set_of
from meridian.platform.evaluation.report import ReportError
from meridian.platform.evaluation.workload import WorkloadEvaluation
from meridian.workloads.$module import evaluation
from meridian.workloads.$module.graph import build


def golden_set() -> Path:
    evaluations = Path(__file__).resolve().parents[4] / "data" / "evaluation"
    return evaluations / "$name" / "golden"


def test_the_graph_compiles_and_answers_with_its_agent() -> None:
    graph = build(None, None).compile()

    answer = graph.invoke({"request": {}})

    assert answer["output"] == {"agent": "$name"}


def test_the_evaluation_is_published_and_the_golden_set_holds_no_case() -> None:
    golden = golden_set()

    fingerprint = golden_set_of(golden / "manifest.json")

    assert isinstance(evaluation.EVALUATION, WorkloadEvaluation)
    assert tuple(fingerprint.files) == ("cases.json",)
    assert evaluation.EVALUATION.submissions(golden) == ()


def test_the_evaluation_has_no_graders_yet() -> None:
    with pytest.raises(ReportError):
        evaluation.EVALUATION.report({}, golden_set(), None)
