{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "advisorModel": "fable",
  "enabledPlugins": {
    "ecc@ecc": false
  },
  "env": {
    "GATEGUARD_BASH_ROUTINE_DISABLED": "1",
    "GATEGUARD_EXEMPT_GLOBS": "**/*.md,docs/**,**/docs/**,tests/**,**/tests/**,.context/**,/private/tmp/claude-*/**,/tmp/claude-*/**",
    "ECC_SKIP_LLM_SUMMARY": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(python3 *)",
      "Bash(make *)",
      "Bash(jq *)",
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(actionlint *)",
      "Bash(gitleaks *)",
      "Bash(trivy *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git --no-pager *)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(docker images*)",
      "Bash(docker ps*)",
      "Bash(docker run --rm *)",
      "Bash(kind get *)",
      "Bash(kind create *)",
      "Bash(kind load *)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl port-forward*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl config current-context*)",
      "Bash(kubectl config use-context kind-*)",
      "Bash(helm lint*)",
      "Bash(helm template*)",
      "Bash(helm list*)",
      "Bash(helm status*)",
      "Bash(helm dependency*)",
      "Bash(helm repo *)",
      "Bash(terraform fmt*)",
      "Bash(terraform -chdir=* fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform -chdir=* validate*)",
      "Bash(terraform init*)",
      "Bash(terraform -chdir=* init*)",
      "Bash(terraform plan*)",
      "Bash(terraform -chdir=* plan*)",
      "Bash(az account show*)",
      "Bash(az account list*)",
      "Bash(az * list*)",
      "Bash(az * show*)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(docker push*)",
      "Bash(gh pr merge*)",
      "Bash(helm upgrade*)",
      "Bash(helm install*)",
      "Bash(helm uninstall*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(kind delete*)"
    ],
    "deny": [
      "Bash(terraform destroy*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.tfvars)",
      "Read(./**/kubeconfig*)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./**/*.tfvars)",
      "Bash(az keyvault secret show*)",
      "Bash(az keyvault secret set*)",
      "Bash(az keyvault secret download*)",
      "Bash(az keyvault secret backup*)",
      "Bash(kubectl get secret* -o *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node/run-with-flags.js\" session:start hooks/node/session-start.js minimal,standard,strict"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node/run-with-flags.js\" pre:edit-write:gateguard-fact-force hooks/node/gateguard-fact-force.js standard,strict",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node/run-with-flags.js\" pre:bash:gateguard-fact-force hooks/node/gateguard-fact-force.js standard,strict",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-py.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-iac.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-docs.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-boundary.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node/run-with-flags.js\" pre:compact hooks/node/pre-compact.js standard,strict"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node/run-with-flags.js\" stop:session-end hooks/node/session-end.js minimal,standard,strict",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/node/run-with-flags.js\" session:end:marker hooks/node/session-end-marker.js minimal,standard,strict",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
