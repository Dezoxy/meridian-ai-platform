.DS_Store
._*

# Private context (job ads, chat exports, plans with personal notes)
.context/

# Structurizr: regenerated on every load while all views use autoLayout.
docs/architecture/workspace.json
docs/architecture/.structurizr/
docs/architecture/generated/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.import_linter_cache/
.eval/
# What a paid run's writer can leave after a hard kill: a staging directory
# (.injection-run-*.tmp) or a temporary file of the recording and report writers
# (.NAME.XXXX.tmp), which hold a model's text. Never committed by git add -A.
data/evaluation/**/.*.tmp
.alerts/
dist/
# What a COVERAGE=1 run leaves in the working directory: the combined data file
# and, while the workers run, one per process.
.coverage
.coverage.*

# Local secrets and environment
.env
.env.*
*.tfvars
!*.tfvars.example
kubeconfig*
# The mock issuer's realm and the passwords and client secrets generated for it
# (infra/kind/identity-realm.sh): made at `make up`, never committed.
/infra/kind/.identity/
infra/terraform/local.env*

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
# The record aws.sh keeps beside a saved plan (the commit and the time).
*.tfplan.meta
# Files that change what Terraform does or hold values that must not be
# committed: override files, JSON variable files, a CLI configuration (it can
# point Terraform at a provider binary the lock file never checked) and a log
# (TF_LOG_PATH). aws.sh refuses to run with an override or a variable file in
# the module's directory; ignoring them keeps one from being committed by hand.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars.json
.terraformrc
terraform.rc
tf.log

# Claude Code local state
.claude/settings.local.json
# The session's board of parallel lanes, read by .claude/hooks/check-lanes.sh
.claude/lanes.md
.claude/ecc/
