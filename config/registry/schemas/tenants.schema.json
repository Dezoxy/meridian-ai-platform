{
  "$defs": {
    "ExchangeRate": {
      "additionalProperties": false,
      "description": "The planning rate the EUR cost quota is computed with.",
      "properties": {
        "checked": {
          "format": "date",
          "title": "Checked",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "usd_per_eur": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Usd Per Eur"
        }
      },
      "required": [
        "usd_per_eur",
        "source",
        "checked"
      ],
      "title": "ExchangeRate",
      "type": "object"
    },
    "Tenant": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Agents",
          "type": "array"
        },
        "data_class": {
          "enum": [
            "synthetic",
            "internal",
            "personal",
            "special"
          ],
          "title": "Data Class",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/TenantLimits"
        }
      },
      "required": [
        "id",
        "description",
        "data_class",
        "agents",
        "limits"
      ],
      "title": "Tenant",
      "type": "object"
    },
    "TenantLimits": {
      "additionalProperties": false,
      "description": "What a tenant may use. The two rate windows are Azure OpenAI's own.",
      "properties": {
        "cost_per_month_eur": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
              "type": "string"
            }
          ],
          "title": "Cost Per Month Eur"
        },
        "requests_per_10_seconds": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Requests Per 10 Seconds",
          "type": "integer"
        },
        "tokens_per_day": {
          "minimum": 1,
          "title": "Tokens Per Day",
          "type": "integer"
        },
        "tokens_per_minute": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Tokens Per Minute",
          "type": "integer"
        }
      },
      "required": [
        "requests_per_10_seconds",
        "tokens_per_minute",
        "tokens_per_day",
        "cost_per_month_eur"
      ],
      "title": "TenantLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "exchange": {
      "$ref": "#/$defs/ExchangeRate"
    },
    "tenants": {
      "items": {
        "$ref": "#/$defs/Tenant"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "required": [
    "exchange",
    "tenants"
  ],
  "title": "TenantsFile",
  "type": "object"
}
