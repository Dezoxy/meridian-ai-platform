            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(meridian_gateway_tokens_total{job=\"model-gateway\"}[${__range_s}s]) - (meridian_gateway_tokens_total{job=\"model-gateway\"} offset ${__range_s}s or last_over_time(meridian_gateway_tokens_total{job=\"model-gateway\"}[${__range_s}s]) * 0))",
          "instant": true,
