    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time since the meridian-sweep CronJob last succeeded. Amber over 10 minutes, red over 15.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 7
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"meridian\", cronjob=\"meridian-sweep\"}",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Since the sweep last succeeded",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of completed and failed gateway calls that completed, over the selected time range. Calls the gateway refused are not counted. No data when there were no calls.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 7
      },
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(meridian_gateway_calls_total{job=\"model-gateway\", meridian_outcome=\"completed\"}[${__range_s}s]) - (last_over_time(meridian_gateway_calls_total{job=\"model-gateway\", meridian_outcome=\"completed\"}[24h] offset ${__range_s}s) or last_over_time(meridian_gateway_calls_total{job=\"model-gateway\", meridian_outcome=\"completed\"}[${__range_s}s]) * 0)) / sum(last_over_time(meridian_gateway_calls_total{job=\"model-gateway\", meridian_outcome=~\"completed|failed\"}[${__range_s}s]) - (last_over_time(meridian_gateway_calls_total{job=\"model-gateway\", meridian_outcome=~\"completed|failed\"}[24h] offset ${__range_s}s) or last_over_time(meridian_gateway_calls_total{job=\"model-gateway\", meridian_outcome=~\"completed|failed\"}[${__range_s}s]) * 0))",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Model calls answered",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alerts Prometheus evaluates as firing now. Nobody is notified; this table is where a firing alert shows.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No alert is firing"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\", platform=\"meridian\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "slo": 2
            }
          }
        }
      ],
      "type": "table"
    },
