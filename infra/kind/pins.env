# Every version and digest the local platform depends on, in one place.
# KEY=value lines only: the scripts source this file, so no spaces around "="
# and no command substitution. Change a pin here, then run `make up` again.
# Looked up 2026-09-30. .github/renovate.json reads them, for Renovate to
# propose newer ones: a version line carries a '# renovate:' comment right
# above it that says where the version comes from, and an image pinned as
# name:tag@digest needs none.
#
# Every image a chart runs is pinned by digest, in one shape (S063): three
# lines, X_IMAGE_REPOSITORY (only where up.sh needs the name), then the
# '# renovate: datasource=docker' comment, X_IMAGE_TAG and X_IMAGE_DIGEST right
# below it. up.sh passes the tag and the digest to the chart with --set. The tag
# is the one the chart installs by default at the chart version above: change
# the chart, then read the new tags with the command in infra/kind/README.md.
# The digest is the multi-architecture index digest of that tag, as
# 'sha256:<64 hex>'. What a chart's key takes differs (the README says which):
# 'digest' takes it as it is; 'sha' in kube-prometheus-stack and Grafana wants the
# hex alone, so up.sh strips the prefix; Tempo and CloudNativePG have no digest
# key, so up.sh writes 'tag@digest' into the tag.

# ── cluster ──────────────────────────────────────────────────────────────────
CLUSTER_NAME=meridian
# kind release the node image below was built for; up.sh warns on a mismatch.
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# Kubernetes 1.36 is the newest minor that is generally available on AKS.
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# ── Helm charts (one chart per release; versions are exact) ──────────────────
ENVOY_GATEWAY_CHART=oci://docker.io/envoyproxy/gateway-helm
# renovate: datasource=docker depName=envoyproxy/gateway-helm
ENVOY_GATEWAY_VERSION=v1.9.2

# Issues the certificates the Meridian services prove their identity with (S055).
CERT_MANAGER_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART=cert-manager
# renovate: datasource=helm depName=cert-manager registryUrl=https://charts.jetstack.io
CERT_MANAGER_VERSION=v1.21.2
# Decides which certificate requests cert-manager's issuers sign (S056):
# cert-manager's own approver is off, and this add-on, from the same repository,
# approves only what the policies in manifests/certificate-policy.yaml allow.
APPROVER_POLICY_CHART=cert-manager-approver-policy
# renovate: datasource=helm depName=cert-manager-approver-policy registryUrl=https://charts.jetstack.io
APPROVER_POLICY_VERSION=v0.28.0

CNPG_REPO=https://cloudnative-pg.github.io/charts
CNPG_OPERATOR_CHART=cloudnative-pg
# renovate: datasource=helm depName=cloudnative-pg registryUrl=https://cloudnative-pg.github.io/charts
CNPG_OPERATOR_VERSION=0.29.1
CNPG_CLUSTER_CHART=cluster
# renovate: datasource=helm depName=cluster registryUrl=https://cloudnative-pg.github.io/charts
CNPG_CLUSTER_VERSION=0.8.1

# Grafana comes with this chart as a subchart (grafana chart 13.2.7).
PROMETHEUS_STACK_REPO=https://prometheus-community.github.io/helm-charts
PROMETHEUS_STACK_CHART=kube-prometheus-stack
# renovate: datasource=helm depName=kube-prometheus-stack registryUrl=https://prometheus-community.github.io/helm-charts
PROMETHEUS_STACK_VERSION=91.8.2

# Grafana moved its open-source charts to grafana-community in 2026.
GRAFANA_COMMUNITY_REPO=https://grafana-community.github.io/helm-charts
TEMPO_CHART=tempo
# renovate: datasource=helm depName=tempo registryUrl=https://grafana-community.github.io/helm-charts
TEMPO_VERSION=3.1.0
LOKI_CHART=loki
# renovate: datasource=helm depName=loki registryUrl=https://grafana-community.github.io/helm-charts
LOKI_VERSION=18.13.7

OTEL_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_CHART=opentelemetry-collector
# renovate: datasource=helm depName=opentelemetry-collector registryUrl=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_VERSION=0.174.0

# ── images pinned by digest (multi-arch index digests) ───────────────────────
# CloudNativePG "standard" image: PostgreSQL 17 with pgvector.
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:17.11-standard-trixie@sha256:db440678e1eca4f53999f819a6200ceb4b8cd2339c568c9bb0596052d3bc4ac5
# Core collector distribution: has the OTLP receiver and exporters, batch,
# memory_limiter and health_check, and nothing else.
OTEL_COLLECTOR_IMAGE_REPOSITORY=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector
# renovate: datasource=docker depName=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector
OTEL_COLLECTOR_IMAGE_TAG=0.162.0
OTEL_COLLECTOR_IMAGE_DIGEST=sha256:310a800ad69ee430e7c541796852a242c9c7db97aaad4daa5ccf843c525fbdb2
# Same release as the collector; used by smoke.sh only.
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.162.0@sha256:5350f77dbc914034321dc7629058e141996c8dc2cdde076d281e573efee1a67e

# ── images the charts run, by digest (S063; digests read 2026-10-06) ─────────
# One block per chart, the tags those chart versions install by default.
# Envoy Gateway: the controller, its certgen hook and the proxy's shutdown
# manager are this one image (the chart takes a whole reference, hence the
# repository). The proxy itself is not here: the controller's own default is
# already a digest (envoy distroless-v1.39.1@sha256:eb2c01c1...).
ENVOY_GATEWAY_IMAGE_REPOSITORY=docker.io/envoyproxy/gateway
# renovate: datasource=docker depName=docker.io/envoyproxy/gateway
ENVOY_GATEWAY_IMAGE_TAG=v1.9.2
ENVOY_GATEWAY_IMAGE_DIGEST=sha256:9d67017c442a70e6ae9f1a358e6c80eb653c67c2e40823d9a991e0daf37ba926

# cert-manager's four components; the acme solver (a flag of the controller)
# is never started here, and stays by tag.
# renovate: datasource=docker depName=quay.io/jetstack/cert-manager-controller
CERT_MANAGER_CONTROLLER_IMAGE_TAG=v1.21.2
CERT_MANAGER_CONTROLLER_IMAGE_DIGEST=sha256:70f532fd9cfde0b09d55687200942399d89838bc2d5d5b45152eb799a15912b8
# renovate: datasource=docker depName=quay.io/jetstack/cert-manager-webhook
CERT_MANAGER_WEBHOOK_IMAGE_TAG=v1.21.2
CERT_MANAGER_WEBHOOK_IMAGE_DIGEST=sha256:a60e2dac46dbb8a7f3df95c54ce941012f54c2fe022f0ee55aaa1ab40ed957ae
# renovate: datasource=docker depName=quay.io/jetstack/cert-manager-cainjector
CERT_MANAGER_CAINJECTOR_IMAGE_TAG=v1.21.2
CERT_MANAGER_CAINJECTOR_IMAGE_DIGEST=sha256:c85268c64f2e0e76684bf5fe8906caff34b82523561c6affe0fae3546bd87562
# renovate: datasource=docker depName=quay.io/jetstack/cert-manager-startupapicheck
CERT_MANAGER_STARTUPAPICHECK_IMAGE_TAG=v1.21.2
CERT_MANAGER_STARTUPAPICHECK_IMAGE_DIGEST=sha256:46e75b6866359ffb5d82624f41e3ed1c70b2994982702ced547ce5edb418a8f5

# renovate: datasource=docker depName=quay.io/jetstack/cert-manager-approver-policy
APPROVER_POLICY_IMAGE_TAG=v0.28.0
APPROVER_POLICY_IMAGE_DIGEST=sha256:1a955b0a5c41d319fd56b5f85aaff6f2eaba01d70f3b1adf001eac4d7b1d49e5

# The CloudNativePG operator. Its image is also the init container that puts the
# instance manager into every database pod (the chart's OPERATOR_IMAGE_NAME).
# renovate: datasource=docker depName=ghcr.io/cloudnative-pg/cloudnative-pg
CNPG_OPERATOR_IMAGE_TAG=1.30.1
CNPG_OPERATOR_IMAGE_DIGEST=sha256:923c267ec29636db3bee20f993d0ec4973fa22998e1adad37da79e4d32b5bc07

# kube-prometheus-stack: the operator and the config reloader it starts by a
# flag, the admission webhook's certgen jobs, Prometheus (a field of its custom
# resource), kube-state-metrics, Grafana and Grafana's sidecar (both of its
# containers). The Prometheus tag is also the Makefile's PROMTOOL_IMAGE. Not
# here: node-exporter (off on kind) and the Thanos image (never started).
# renovate: datasource=docker depName=quay.io/prometheus-operator/prometheus-operator
PROMETHEUS_OPERATOR_IMAGE_TAG=v0.94.1
PROMETHEUS_OPERATOR_IMAGE_DIGEST=sha256:7c88d4e7bae63bd8d0f8da986054337c23b4472fa8d3c6817f5bc4b8407a2d6a
# renovate: datasource=docker depName=quay.io/prometheus-operator/prometheus-config-reloader
PROMETHEUS_CONFIG_RELOADER_IMAGE_TAG=v0.94.1
PROMETHEUS_CONFIG_RELOADER_IMAGE_DIGEST=sha256:06b52bd4dbe3ed6dd5905aadaf8b9987d9da4c31d37bb86deaadae68cee2d26b
# renovate: datasource=docker depName=ghcr.io/jkroepke/kube-webhook-certgen
KUBE_WEBHOOK_CERTGEN_IMAGE_TAG=1.8.9
KUBE_WEBHOOK_CERTGEN_IMAGE_DIGEST=sha256:58e4ac2e15bf7785eb00ac90d03f9be1ff3f2fe0add6c71b54af6e5c80031148
# renovate: datasource=docker depName=quay.io/prometheus/prometheus
PROMETHEUS_IMAGE_TAG=v3.15.0-distroless
PROMETHEUS_IMAGE_DIGEST=sha256:b2a413d5a03ea6a76782a508d1c7947440bba3b973931a25676e278431891b01
# renovate: datasource=docker depName=registry.k8s.io/kube-state-metrics/kube-state-metrics
KUBE_STATE_METRICS_IMAGE_TAG=v2.20.0
KUBE_STATE_METRICS_IMAGE_DIGEST=sha256:42cfe3723a5f058171c627537fb57a3ea0f26e4380fa18555a95cb1a1b4cfc5b
# renovate: datasource=docker depName=docker.io/grafana/grafana
GRAFANA_IMAGE_TAG=13.2.3-distroless
GRAFANA_IMAGE_DIGEST=sha256:202e5d5b3f8499e70ccac7991eea6d7da72d2790eb2e0597e7987acf724e7180
# renovate: datasource=docker depName=quay.io/kiwigrid/k8s-sidecar
GRAFANA_SIDECAR_IMAGE_TAG=2.11.2
GRAFANA_SIDECAR_IMAGE_DIGEST=sha256:2912be006f62f9ea080194cf6d3afcd90daead8d101d0ba686a137a849f6a4f6

# renovate: datasource=docker depName=docker.io/grafana/tempo
TEMPO_IMAGE_TAG=3.1.0
TEMPO_IMAGE_DIGEST=sha256:3076b8dcdfb32fd6bc5ccef85e7b7313e6199b9cb84366257fc17ecb696db5fd
# renovate: datasource=docker depName=docker.io/grafana/loki
LOKI_IMAGE_TAG=3.7.8
LOKI_IMAGE_DIGEST=sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193
