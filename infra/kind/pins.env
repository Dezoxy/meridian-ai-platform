# Every version and digest the local platform depends on, in one place.
# KEY=value lines only: the scripts source this file, so no spaces around "="
# and no command substitution. Change a pin here, then run `make up` again.
# Looked up 2026-09-30.

# ── cluster ──────────────────────────────────────────────────────────────────
CLUSTER_NAME=meridian
# kind release the node image below was built for; up.sh warns on a mismatch.
KIND_VERSION=v0.33.0
# Kubernetes 1.36 is the newest minor that is generally available on AKS.
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# ── Helm charts (one chart per release; versions are exact) ──────────────────
ENVOY_GATEWAY_CHART=oci://docker.io/envoyproxy/gateway-helm
ENVOY_GATEWAY_VERSION=v1.9.2

CNPG_REPO=https://cloudnative-pg.github.io/charts
CNPG_OPERATOR_CHART=cloudnative-pg
CNPG_OPERATOR_VERSION=0.29.1
CNPG_CLUSTER_CHART=cluster
CNPG_CLUSTER_VERSION=0.8.1

# Grafana comes with this chart as a subchart (grafana chart 13.2.7).
PROMETHEUS_STACK_REPO=https://prometheus-community.github.io/helm-charts
PROMETHEUS_STACK_CHART=kube-prometheus-stack
PROMETHEUS_STACK_VERSION=91.8.2

# Grafana moved its open-source charts to grafana-community in 2026.
GRAFANA_COMMUNITY_REPO=https://grafana-community.github.io/helm-charts
TEMPO_CHART=tempo
TEMPO_VERSION=3.1.0
LOKI_CHART=loki
LOKI_VERSION=18.13.7

OTEL_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_CHART=opentelemetry-collector
OTEL_COLLECTOR_VERSION=0.174.0

# ── images pinned by digest (multi-arch index digests) ───────────────────────
# CloudNativePG "standard" image: PostgreSQL 17 with pgvector.
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:17.11-standard-trixie@sha256:db440678e1eca4f53999f819a6200ceb4b8cd2339c568c9bb0596052d3bc4ac5
# Core collector distribution: has the OTLP receiver and exporters, batch,
# memory_limiter and health_check, and nothing else.
OTEL_COLLECTOR_IMAGE_REPOSITORY=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector
OTEL_COLLECTOR_IMAGE_TAG=0.161.0
OTEL_COLLECTOR_IMAGE_DIGEST=sha256:b6d2b9a85b1029d05b5ad913150c1f014eed4ae99be81a1813ca5ade4a191913
# Same release as the collector; used by smoke.sh only.
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.161.0@sha256:de5a352a31aaf103b70d6cca4001d0802e3fc2f902a9ea110ebe0bbe501000cb
