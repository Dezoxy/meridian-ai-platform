#!/bin/bash
# A worker node's boot script (cloud-init user data), rendered by nodes.tf. It
# has never run on a real node: tests/meridian/test_aws_kubeadm_bootstrap.py
# runs it against stand-in programs.
#
# It holds NO secret. The workers boot before the control plane has written
# the join command, so the script polls the parameter, with a bound, until the
# value is a join command, and then joins.
#
# THE PARAMETER'S TEXT IS NEVER RUN. Whoever can write that parameter (the
# control plane's role and the owner) must not thereby get a shell on a worker.
# The value is matched against one strict pattern, the address in it must be the
# control plane's own, and the token and the CA hash that the pattern captured
# are handed to kubeadm as arguments. A value of any other shape, the
# placeholder and an empty value included, is "not a join command yet".
#
# Four settings have defaults and may be set in the environment: a test shortens
# them, and cloud-init sets none of them. Two are below the "Bounds" heading
# (JOIN_ATTEMPTS and POLL_SECONDS: BOOT_ROOT, the root prefix a test points
# elsewhere, is the third line there), two are in the text shared with the control
# plane (CONTAINERD_ATTEMPTS and APT_ATTEMPTS).
#
# Terraform renders this file: every shell parameter expansion is written with
# a doubled dollar sign, and no percent sign is followed by a brace.
set -euo pipefail
# The alphabet of the join pattern (node-common) is bytes: see the note there.
export LC_ALL=C
export HOME=/root
export PATH="$PATH:/snap/bin"

ROLE='worker'
REGION='${region}'
CONTROL_PLANE_ADDRESS='${control_plane_address}'
API_PORT='${api_port}'
JOIN_PARAMETER_NAME='${join_parameter_name}'

# Bounds: a number of tries and the seconds between two of them.
BOOT_ROOT="$${BOOT_ROOT:-}"
# 240 tries of 10 seconds are 40 minutes of pauses, and the reads add to that
# (about 44 minutes in all, an estimate). The control plane is created after the
# workers, and what only it spends before the join command exists (the command
# is made at the very end of its script, by `kubeadm token create`) can add up to
# more than the old 20 minutes: a test holds the window above the sum of its
# bounds. The
# token lives an hour from that command, not from this boot, so a longer poll
# costs nothing: a worker that gave up would bill the same.
JOIN_ATTEMPTS="$${JOIN_ATTEMPTS:-240}"
POLL_SECONDS="$${POLL_SECONDS:-10}"

${common}

# What to say of the CLI's last error, from its error file $1: the first line,
# at most 2000 bytes of it read, with every byte outside printable ASCII (the
# alphabet is bytes: LC_ALL=C above) replaced by a question mark, cut to 400
# characters (an AccessDenied message names the caller, the action and the
# resource before its reason, and runs to about 350). An AWS error line names an
# operation and a reason and holds no parameter value, so no value is expected
# here. But the line is text from outside, so one that has the shape of a token,
# of a CA hash or of a join command is not shown at all: a line of the log is read
# by whoever reads the log, for the node's life. The order is: look for the
# shapes, make the line printable, cut it. The shapes are looked for on the line
# as read with its non-printable bytes DELETED, which holds every match the line as
# read holds and also the one a byte inside a token breaks (a token of which one
# character is an accented letter: the question marks that replace it would leave
# no token shape to find, and the tail would be shown).
the_last_error() {
  local line='' token_shape='[a-z0-9]{6}\.[a-z0-9]{16}' hash_shape='[0-9a-f]{64}'
  local bare
  IFS= read -r -n 2000 line <"$1" || true
  bare=$${line//[^ -~]/}
  if [[ $bare =~ $token_shape || $bare =~ $hash_shape || $bare == *'kubeadm join'* ]]; then
    printf '%s' 'a line that looked like a join command, withheld'
    return 0
  fi
  line=$${line//[^ -~]/?}
  if [[ -z $line ]]; then
    printf '%s' 'the AWS CLI printed no message'
  else
    printf '%s' "$${line:0:400}"
  fi
}

# Reads the parameter until it holds a join command for the control plane's
# address, and leaves its token and hash in JOIN_TOKEN and JOIN_HASH. The value
# is never printed: it is a secret for an hour, and it may be anything.
#
# A read that fails is a try like any other (the placeholder is "not there yet"),
# but the CLI's error stream goes to a file in the private directory, and the
# line the worker gives up with carries the last failed read's error: without
# it, a refusal (AccessDenied, no credentials, a wrong region) looks like a
# parameter that was never written, and the hour is spent not knowing. A read
# that succeeds clears it: the line describes the last try, not an old one. The
# error is also logged when it is first seen and whenever it changes (not on every
# try, so a refusal shows at the first try and not at the end of the window), in
# the same masked form.
#
# Each read is cut off at 30 seconds (`timeout`, which exits 124 then): the AWS
# CLI's own connection timeout and retries (from memory, no page was read) could
# make a try last minutes, and the bound here is a number of tries. A try that
# was cut off is "not there yet" like any other, and says so if it was the last.
wait_for_the_join_command() {
  local attempt value status last_error='' logged_error=''
  local error_file="$WORK_DIR/aws-error"
  for ((attempt = 1; attempt <= JOIN_ATTEMPTS; attempt++)); do
    # A NUL byte cannot live in a bash variable: command substitution would drop
    # it and print a warning of its own. tr turns each one into a byte (\001) that
    # no join command holds, so the value is refused by the pattern, silently, and
    # never read as the join command that is left when the NUL is dropped.
    if value=$(timeout 30 aws ssm get-parameter --region "$REGION" --name "$JOIN_PARAMETER_NAME" \
      --with-decryption --query Parameter.Value --output text 2>"$error_file" |
      tr '\000' '\001'); then
      last_error=''
      logged_error=''
    else
      status=$?
      value=''
      if ((status == 124)); then
        last_error='the AWS CLI did not answer within 30 seconds'
      else
        last_error=$(the_last_error "$error_file")
      fi
      if [[ $last_error != "$logged_error" ]]; then
        log "the AWS CLI reported: $last_error"
        logged_error=$last_error
      fi
    fi
    if parse_join_command "$value" "$CONTROL_PLANE_ADDRESS:$API_PORT"; then
      log "the parameter holds a join command"
      return 0
    fi
    log "the parameter does not hold a join command yet (try $attempt of $JOIN_ATTEMPTS)"
    sleep "$POLL_SECONDS"
  done
  die "gave up after $JOIN_ATTEMPTS tries: $JOIN_PARAMETER_NAME never held a join command for $CONTROL_PLANE_ADDRESS:$API_PORT$${last_error:+; the last error of the AWS CLI: $last_error}"
}

# Once per node, and the first thing the script does, before it installs or
# restarts anything: a node that has a kubelet configuration has joined, and
# nothing on it is touched.
refuse_a_second_run() {
  local kubelet_conf="$BOOT_ROOT/etc/kubernetes/kubelet.conf"
  [[ ! -e $kubelet_conf ]] || die "this node already has $kubelet_conf, so it has joined: kubeadm join runs once per node"
}

# One shot, no retry. The join command may be older than the control plane (the
# control plane was replaced and the parameter, with the same address, kept), and
# then it is well formed and kubeadm refuses it: the line says what to do.
join_the_cluster() {
  log "running kubeadm join"
  kubeadm join "$CONTROL_PLANE_ADDRESS:$API_PORT" \
    --token "$JOIN_TOKEN" \
    --discovery-token-ca-cert-hash "sha256:$JOIN_HASH" ||
    die "kubeadm join failed. The join command in the parameter may be older than the control plane (the control plane was replaced and the parameter kept): remove this environment and apply it again."
}

for setting in JOIN_ATTEMPTS POLL_SECONDS CONTAINERD_ATTEMPTS APT_ATTEMPTS; do
  require_number "$setting"
done

refuse_a_second_run
make_work_dir

install_aws_cli
install_node
wait_for_the_join_command
join_the_cluster
log "done"
