{
  "server": "policy-mcp",
  "description": "Policy and claim-history lookups.",
  "tools": [
    {
      "name": "policy_lookup",
      "description": "Look up a policy by its number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "policy_number": {
            "type": "string",
            "pattern": "^POL-[0-9]{4}$",
            "maxLength": 8
          }
        },
        "required": [
          "policy_number"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "policy": {
            "type": "object",
            "properties": {
              "policy_number": {
                "type": "string",
                "pattern": "^POL-[0-9]{4}$",
                "maxLength": 8
              },
              "product": {
                "type": "string",
                "maxLength": 32
              },
              "wording_version": {
                "type": "string",
                "maxLength": 16
              },
              "start_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "maxLength": 10
              },
              "end_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "maxLength": 10
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "lapsed"
                ]
              },
              "lapsed_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "maxLength": 10
              },
              "deductible": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "sum_insured": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "limit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            },
            "required": [
              "policy_number",
              "product",
              "wording_version",
              "start_date",
              "end_date",
              "status",
              "deductible",
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "found"
        ],
        "if": {
          "properties": {
            "found": {
              "const": true
            }
          },
          "required": [
            "found"
          ]
        },
        "then": {
          "required": [
            "policy"
          ]
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "meridian/scope": "policy:read",
        "meridian/idempotency-key-required": false,
        "meridian/approval-required": false
      }
    },
    {
      "name": "claim_history",
      "description": "List earlier claims on a policy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "policy_number": {
            "type": "string",
            "pattern": "^POL-[0-9]{4}$",
            "maxLength": 8
          }
        },
        "required": [
          "policy_number"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "history_id": {
                  "type": "string",
                  "pattern": "^(HIST|CLM)-[0-9]{4}$",
                  "maxLength": 9
                },
                "loss_date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "maxLength": 10
                },
                "peril": {
                  "type": "string",
                  "maxLength": 64
                },
                "paid_amount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "status": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "history_id",
                "loss_date",
                "peril",
                "paid_amount",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "entries",
          "truncated"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "meridian/scope": "claims:history:read",
        "meridian/idempotency-key-required": false,
        "meridian/approval-required": false
      }
    }
  ]
}
